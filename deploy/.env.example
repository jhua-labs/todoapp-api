# staging 凭据模板（AD-15）。用法：在 todoapp-api/deploy/ 下 cp .env.example .env，再填写 .env。
# deploy/.env 已在 todoapp-api/.gitignore 里，不提交；本文件只放占位，不得写真实密码。
# compose 用这些变量同时配置 db（postgres 官方镜像）和 api（SPRING_DATASOURCE_*）。

# 数据库名
POSTGRES_DB=todoapp
# 数据库用户名
POSTGRES_USER=todoapp
# 数据库密码：在 .env 里换成真实的强密码
POSTGRES_PASSWORD=change-me
